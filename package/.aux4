{
  "scope": "aux4",
  "name": "ai-agent",
  "version": "1.3.24",
  "description": "AI agent",
  "tags": [
    "ai",
    "agent",
    "llm"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "ai",
          "execute": [
            "profile:ai"
          ],
          "help": {
            "text": "Artificial Intelligence"
          }
        }
      ]
    },
    {
      "name": "ai",
      "commands": [
        {
          "name": "agent",
          "execute": [
            "profile:ai:agent"
          ],
          "help": {
            "text": "Artificial Intelligence Agent"
          }
        }
      ]
    },
    {
      "name": "ai:agent",
      "commands": [
        {
          "name": "ask",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-ai-agent.cjs ask values(baseInstructions, instructions, role, history, outputSchema, question, image, context, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills, policy, runId, costs, tools) --packageDir ${packageDir}"
          ],
          "help": {
            "text": "Ask your question",
            "variables": [
              {
                "name": "baseInstructions",
                "text": "Base instructions file loaded before the main instructions",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as history",
                "default": ""
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "tools",
                "text": "Comma-separated allow-list of tool names to bind (executeAux4 plus any MCP tools from mcp.json); unlisted names are not exposed to the model. Empty: bind everything",
                "default": ""
              },
              {
                "name": "policy",
                "text": "Optional policy guardrails as an inline object (budget/allow/deny/escalate), delivered as JSON",
                "default": ""
              },
              {
                "name": "runId",
                "text": "Optional run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Optional cost rates as JSON (costIn, costOut, costCache per 1M tokens) used for the policy usd budget",
                "default": "{}"
              },
              {
                "name": "question",
                "text": "The question to ask",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "image",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs image values(prompt, image, size, quality, context, model, quantity)"
          ],
          "help": {
            "text": "Generate an image from a text prompt",
            "variables": [
              {
                "name": "prompt",
                "text": "The text prompt describing the image to generate",
                "arg": true
              },
              {
                "name": "image",
                "text": "The file path where to save the generated image"
              },
              {
                "name": "size",
                "text": "The image size (e.g., 1024x1024, 1792x1024, 1024x1792)",
                "default": "1024x1024"
              },
              {
                "name": "quality",
                "text": "The image quality (DALL-E: standard/hd, gpt-image: low/medium/high/auto)",
                "default": "auto",
                "options": [
                  "standard",
                  "hd",
                  "low",
                  "medium",
                  "high",
                  "auto"
                ]
              },
              {
                "name": "context",
                "text": "Read additional context from stdin",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"dall-e-3\"}})",
                "default": "{}"
              },
              {
                "name": "quantity",
                "text": "Number of images to generate (creates numbered files if > 1)",
                "default": "1"
              }
            ]
          }
        },
        {
          "name": "chat",
          "execute": [
            "set:question=${text}",
            "log:> ${text}",
            "stdin:aux4 ai agent ask params(instructions, role, history, outputSchema, text, image, context, question, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills)",
            "stdin:if(text==exit) && echo exit || aux4 ai agent chat params(instructions, role, history, outputSchema, image, context, model, storage, autoCompact, compaction, bio, permissions, models, useModel, references, skills)"
          ],
          "help": {
            "text": "Chat with the AI agent",
            "variables": [
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as history",
                "default": "history.json"
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "text",
                "text": "The text",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "history",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs history values(historyFile, costIn, costOut, costCache)"
          ],
          "help": {
            "text": "Display a formatted view of conversation history",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to display",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "costIn",
                "text": "Cost per 1M input tokens (e.g. 3.0 for Claude Sonnet)",
                "default": "0"
              },
              {
                "name": "costOut",
                "text": "Cost per 1M output tokens (e.g. 15.0 for Claude Sonnet)",
                "default": "0"
              },
              {
                "name": "costCache",
                "text": "Cost per 1M cached input tokens (e.g. 0.30 for Claude Sonnet)",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "summarize",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs summarize values(historyFile, model, models, useModel)"
          ],
          "help": {
            "text": "Summarize conversation history as markdown",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to summarize",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "remember",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs remember values(historyFile, model, models, useModel)"
          ],
          "help": {
            "text": "Generate a concise memory entry from conversation history",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "compact",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs compact values(historyFile, model, keepLastMessages, models, useModel)"
          ],
          "help": {
            "text": "Compact conversation history by summarizing older messages",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to compact",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "keepLastMessages",
                "text": "Number of recent messages to keep verbatim",
                "default": "6"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "models",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs models values(models)"
          ],
          "help": {
            "text": "List available models from the registry",
            "variables": [
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "auth",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs auth values(action)"
          ],
          "help": {
            "text": "Sign in to ChatGPT, list available plan models, check status, or sign out",
            "variables": [
              {
                "name": "action",
                "text": "Authentication action",
                "arg": true,
                "options": [
                  "login",
                  "models",
                  "status",
                  "logout"
                ]
              }
            ]
          }
        },
        {
          "name": "policy",
          "execute": [
            "profile:ai:agent:policy"
          ],
          "help": {
            "text": "Policy guardrail utilities (check decisions, resolve escalations)"
          }
        },
        {
          "name": "tool",
          "execute": [
            "profile:ai:agent:tool"
          ],
          "help": {
            "text": "Run a built-in agent tool command"
          }
        }
      ]
    },
    {
      "name": "ai:agent:policy",
      "commands": [
        {
          "name": "check",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs policy-check values(policy, tool, action, usage, calls, runId, costs)"
          ],
          "help": {
            "text": "Check a policy decision for a tool/action against a spend snapshot",
            "variables": [
              {
                "name": "policy",
                "text": "Inline policy object (budget/allow/deny/escalate) delivered as JSON",
                "default": ""
              },
              {
                "name": "tool",
                "text": "The tool name to check (e.g. executeAux4, writeFile, removeFiles)"
              },
              {
                "name": "action",
                "text": "The action subject: a command for executeAux4, or a file path for file tools",
                "default": "",
                "arg": true
              },
              {
                "name": "usage",
                "text": "Token usage snapshot as JSON (input, output, cached, total)",
                "default": "{}"
              },
              {
                "name": "calls",
                "text": "Consequential tool call count so far",
                "default": "0"
              },
              {
                "name": "runId",
                "text": "Run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Cost rates as JSON (costIn, costOut, costCache per 1M tokens) for the usd budget",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "resolve",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs policy-resolve values(id, decision)"
          ],
          "help": {
            "text": "Resolve a parked (block-mode) policy escalation",
            "variables": [
              {
                "name": "id",
                "text": "The escalation id to resolve",
                "arg": true
              },
              {
                "name": "decision",
                "text": "The decision",
                "options": [
                  "allow_once",
                  "widen",
                  "stop"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ai:agent:tool",
      "commands": [
        {
          "name": "read-file",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool read-file value(input)"
          ],
          "help": {
            "text": "Read a file",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: file (required), offset and limit (optional).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "write-file",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool write-file value(input)"
          ],
          "help": {
            "text": "Write a file",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: file and content (both required).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "edit-file",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool edit-file value(input)"
          ],
          "help": {
            "text": "Edit a file",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: file, old_string, new_string (required); replace_all (optional boolean).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "save-image",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool save-image value(input)"
          ],
          "help": {
            "text": "Save image data",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: imageName and content (both required; content is base64).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "list-files",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool list-files value(input)"
          ],
          "help": {
            "text": "List files",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: path, recursive and exclude (all optional).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "search-files",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool search-files value(input)"
          ],
          "help": {
            "text": "Search file contents",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: pattern (required); path, include, exclude and maxResults (optional).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "create-directory",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool create-directory value(input)"
          ],
          "help": {
            "text": "Create a directory",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: path (required).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "remove-files",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool remove-files value(input)"
          ],
          "help": {
            "text": "Remove agent-created files",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: files (required; string or array of paths).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "search-context",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool search-context value(input)"
          ],
          "help": {
            "text": "Search indexed context",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: query (required); storage, limit, source, embeddingsType and embeddingsConfig (optional).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "ask-user",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool ask-user value(input)"
          ],
          "help": {
            "text": "Ask the user a question",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: question (required).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "current-date-time",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool current-date-time value(input)"
          ],
          "help": {
            "text": "Get the current date and time",
            "variables": [
              {
                "name": "input",
                "text": "Pass an empty JSON object: {}.",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "read-reference",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool read-reference value(input)"
          ],
          "help": {
            "text": "Read a reference",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: file (optional; omit to list references).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "read-skill",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool read-skill value(input)"
          ],
          "help": {
            "text": "Read an installed skill",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: skill (optional; omit to list skills).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "search-text",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool search-text value(input)"
          ],
          "help": {
            "text": "Search text",
            "variables": [
              {
                "name": "input",
                "text": "JSON fields: file and query (required); limit (optional).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "aux4-skill",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs tool aux4-skill value(input)"
          ],
          "help": {
            "text": "Get aux4 skill information",
            "variables": [
              {
                "name": "input",
                "text": "JSON field: skill (optional; omit to list installed skills).",
                "default": "{}",
                "arg": true
              }
            ]
          }
        }
      ]
    }
  ],
  "dependencies": [
    "aux4/ai-rag"
  ]
}
