{
  "scope": "aux4",
  "name": "ai-agent",
  "version": "1.3.9",
  "description": "AI agent",
  "tags": [
    "ai",
    "agent",
    "llm"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "ai",
          "execute": [
            "profile:ai"
          ],
          "help": {
            "text": "Artificial Intelligence"
          }
        }
      ]
    },
    {
      "name": "ai",
      "commands": [
        {
          "name": "agent",
          "execute": [
            "profile:ai:agent"
          ],
          "help": {
            "text": "Artificial Intelligence Agent"
          }
        }
      ]
    },
    {
      "name": "ai:agent",
      "commands": [
        {
          "name": "learn",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs learn values(storage, doc, type)"
          ],
          "help": {
            "text": "Learn from a document or folder",
            "variables": [
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "doc",
                "text": "The document or folder to learn from",
                "arg": true
              },
              {
                "name": "type",
                "text": "The type of document",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "search",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs search values(storage, format, source, limit, query)"
          ],
          "help": {
            "text": "Search on documents",
            "variables": [
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "format",
                "text": "The format of the output",
                "default": "text",
                "options": [
                  "json",
                  "text"
                ]
              },
              {
                "name": "source",
                "text": "The source file path",
                "default": ""
              },
              {
                "name": "limit",
                "text": "The number of results to return",
                "default": "1"
              },
              {
                "name": "query",
                "text": "The query to search for",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "forget",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs forget values(storage, doc)"
          ],
          "help": {
            "text": "Forget learned documents",
            "variables": [
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "doc",
                "text": "File or folder to forget (all if omitted)",
                "default": "",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "ask",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-ai-agent.cjs ask values(baseInstructions, instructions, role, history, outputSchema, question, image, context, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills, policy, runId, costs, tools) --packageDir ${packageDir}"
          ],
          "help": {
            "text": "Ask your question",
            "variables": [
              {
                "name": "baseInstructions",
                "text": "Base instructions file loaded before the main instructions",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as history",
                "default": ""
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "tools",
                "text": "Optional comma-separated allow-list of tool names to bind (e.g. executeAux4,readReference); empty binds all tools",
                "default": ""
              },
              {
                "name": "policy",
                "text": "Optional policy guardrails as an inline object (budget/allow/deny/escalate), delivered as JSON",
                "default": ""
              },
              {
                "name": "runId",
                "text": "Optional run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Optional cost rates as JSON (costIn, costOut, costCache per 1M tokens) used for the policy usd budget",
                "default": "{}"
              },
              {
                "name": "question",
                "text": "The question to ask",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "plan",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-ai-agent-client.cjs plan values(baseInstructions, instructions, role, history, outputSchema, question, image, context, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills, policy, runId, costs, tools) --packageDir ${packageDir}"
          ],
          "help": {
            "text": "Run exactly one LLM turn and return a structured decision (final answer or tool calls) without executing tools",
            "variables": [
              {
                "name": "baseInstructions",
                "text": "Base instructions file loaded before the main instructions",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as conversation history (loaded and checkpointed)",
                "default": ""
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "tools",
                "text": "Optional comma-separated allow-list of tool names to bind (e.g. executeAux4,readReference); empty binds all tools",
                "default": ""
              },
              {
                "name": "policy",
                "text": "Optional policy guardrails as an inline object (budget/allow/deny/escalate), delivered as JSON",
                "default": ""
              },
              {
                "name": "runId",
                "text": "Optional run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Optional cost rates as JSON (costIn, costOut, costCache per 1M tokens) used for the policy usd budget",
                "default": "{}"
              },
              {
                "name": "question",
                "text": "The question or new user message for this turn (optional)",
                "arg": true,
                "default": ""
              }
            ]
          }
        },
        {
          "name": "resume",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-ai-agent-client.cjs resume values(baseInstructions, instructions, role, history, outputSchema, question, image, context, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills, policy, runId, costs, tools, toolResults) --packageDir ${packageDir}"
          ],
          "help": {
            "text": "Inject external tool results into history, then run exactly one LLM turn and return a structured decision (final answer or next tool calls)",
            "variables": [
              {
                "name": "baseInstructions",
                "text": "Base instructions file loaded before the main instructions",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as conversation history (loaded and checkpointed)",
                "default": ""
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "tools",
                "text": "Optional comma-separated allow-list of tool names to bind (e.g. executeAux4,readReference); empty binds all tools",
                "default": ""
              },
              {
                "name": "policy",
                "text": "Optional policy guardrails as an inline object (budget/allow/deny/escalate), delivered as JSON",
                "default": ""
              },
              {
                "name": "runId",
                "text": "Optional run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Optional cost rates as JSON (costIn, costOut, costCache per 1M tokens) used for the policy usd budget",
                "default": "{}"
              },
              {
                "name": "toolResults",
                "text": "Tool results as a JSON file path or inline JSON array of {id, content} matching the pending tool_call ids",
                "default": ""
              },
              {
                "name": "question",
                "text": "An optional new user message to add for this turn",
                "arg": true,
                "default": ""
              }
            ]
          }
        },
        {
          "name": "run-tool",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent-client.cjs run-tool values(storage, permissions, references, skills, tools, toolCall)"
          ],
          "help": {
            "text": "Execute exactly one tool call through the standard ai-agent tool registry and emit {id, content}",
            "variables": [
              {
                "name": "storage",
                "text": "Context storage directory",
                "default": ".context"
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "tools",
                "text": "Optional comma-separated allow-list of tool names",
                "default": ""
              },
              {
                "name": "toolCall",
                "text": "One tool call as inline JSON or a JSON file path",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "run-tools-and-resume",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent-client.cjs run-tools-and-resume values(baseInstructions, instructions, role, history, outputSchema, question, image, context, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills, policy, runId, costs, tools, toolCallsBase64, historySeedBase64) --packageDir ${packageDir}"
          ],
          "help": {
            "text": "Execute a batch of external tool calls and resume one planning turn in the same warm runtime request",
            "variables": [
              { "name": "baseInstructions", "text": "Base instructions file", "default": "" },
              { "name": "instructions", "text": "Agent instructions file", "default": "AGENTS.md" },
              { "name": "role", "text": "Role for an optional new message", "default": "user" },
              { "name": "history", "text": "Durable conversation history file", "default": "" },
              { "name": "outputSchema", "text": "Structured output schema file", "default": "schema.json" },
              { "name": "question", "text": "Optional new user message", "default": "" },
              { "name": "image", "text": "Optional image paths", "default": "" },
              { "name": "context", "text": "Read context from stdin", "default": "false" },
              { "name": "model", "text": "Model configuration JSON", "default": "{}" },
              { "name": "storage", "text": "Context storage directory", "default": ".context" },
              { "name": "stream", "text": "Enable streaming output", "default": "false" },
              { "name": "autoCompact", "text": "Enable history compaction", "default": "false" },
              { "name": "compaction", "text": "Compaction configuration JSON", "default": "{}" },
              { "name": "bio", "text": "Agent bio JSON", "default": "{}" },
              { "name": "permissions", "text": "Tool permissions JSON", "default": "{}" },
              { "name": "models", "text": "Named model registry JSON", "default": "{}" },
              { "name": "useModel", "text": "Named model to use", "default": "" },
              { "name": "references", "text": "References directory", "default": "" },
              { "name": "skills", "text": "Skills directory", "default": ".agents/skills" },
              { "name": "policy", "text": "Policy guardrails JSON", "default": "" },
              { "name": "runId", "text": "Optional run identifier", "default": "" },
              { "name": "costs", "text": "Token cost rates JSON", "default": "{}" },
              { "name": "tools", "text": "Optional comma-separated tool allow-list", "default": "" },
              { "name": "toolCallsBase64", "text": "Base64-encoded tool-call JSON for shell-safe workflow transport", "default": "-" },
              { "name": "historySeedBase64", "text": "Base64-encoded history checkpoint JSON for shell-safe workflow transport", "default": "-" }
            ]
          }
        },
        {
          "name": "image",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs image values(prompt, image, size, quality, context, model, quantity)"
          ],
          "help": {
            "text": "Generate an image from a text prompt",
            "variables": [
              {
                "name": "prompt",
                "text": "The text prompt describing the image to generate",
                "arg": true
              },
              {
                "name": "image",
                "text": "The file path where to save the generated image"
              },
              {
                "name": "size",
                "text": "The image size (e.g., 1024x1024, 1792x1024, 1024x1792)",
                "default": "1024x1024"
              },
              {
                "name": "quality",
                "text": "The image quality (DALL-E: standard/hd, gpt-image: low/medium/high/auto)",
                "default": "auto",
                "options": [
                  "standard",
                  "hd",
                  "low",
                  "medium",
                  "high",
                  "auto"
                ]
              },
              {
                "name": "context",
                "text": "Read additional context from stdin",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"dall-e-3\"}})",
                "default": "{}"
              },
              {
                "name": "quantity",
                "text": "Number of images to generate (creates numbered files if > 1)",
                "default": "1"
              }
            ]
          }
        },
        {
          "name": "chat",
          "execute": [
            "set:question=${text}",
            "log:> ${text}",
            "stdin:aux4 ai agent ask params(instructions, role, history, outputSchema, text, image, context, question, model, storage, stream, autoCompact, compaction, bio, permissions, models, useModel, references, skills)",
            "stdin:if(text==exit) && echo exit || aux4 ai agent chat params(instructions, role, history, outputSchema, image, context, model, storage, autoCompact, compaction, bio, permissions, models, useModel, references, skills)"
          ],
          "help": {
            "text": "Chat with the AI agent",
            "variables": [
              {
                "name": "instructions",
                "text": "The instructions file of the prompt",
                "default": "AGENTS.md"
              },
              {
                "name": "role",
                "text": "The role of the user",
                "default": "user"
              },
              {
                "name": "history",
                "text": "The file to use as history",
                "default": "history.json"
              },
              {
                "name": "outputSchema",
                "text": "The file that represents the JSON schema of the output",
                "default": "schema.json"
              },
              {
                "name": "context",
                "text": "Read context from stdin",
                "default": "false"
              },
              {
                "name": "image",
                "text": "The image path, if more than one, separate with comma",
                "default": ""
              },
              {
                "name": "storage",
                "text": "The storage directory",
                "default": ".context"
              },
              {
                "name": "stream",
                "text": "Enable streaming output",
                "default": "false"
              },
              {
                "name": "model",
                "text": "Model configuration as JSON (e.g., {\"type\":\"openai\",\"config\":{\"model\":\"gpt-4\"}})",
                "default": "{}"
              },
              {
                "name": "autoCompact",
                "text": "Enable auto-compaction of conversation history",
                "default": "false"
              },
              {
                "name": "compaction",
                "text": "Compaction configuration as JSON",
                "default": "{}"
              },
              {
                "name": "bio",
                "text": "Agent bio as JSON (name, role, description)",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Permissions configuration as JSON (allow, ask, deny arrays)",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use for this request",
                "default": ""
              },
              {
                "name": "references",
                "text": "Path to the references directory",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to the skills directory",
                "default": ".agents/skills"
              },
              {
                "name": "text",
                "text": "The text",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "history",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs history values(historyFile, costIn, costOut, costCache)"
          ],
          "help": {
            "text": "Display a formatted view of conversation history",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to display",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "costIn",
                "text": "Cost per 1M input tokens (e.g. 3.0 for Claude Sonnet)",
                "default": "0"
              },
              {
                "name": "costOut",
                "text": "Cost per 1M output tokens (e.g. 15.0 for Claude Sonnet)",
                "default": "0"
              },
              {
                "name": "costCache",
                "text": "Cost per 1M cached input tokens (e.g. 0.30 for Claude Sonnet)",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "summarize",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs summarize values(historyFile, model, models, useModel)"
          ],
          "help": {
            "text": "Summarize conversation history as markdown",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to summarize",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "remember",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs remember values(historyFile, model, models, useModel)"
          ],
          "help": {
            "text": "Generate a concise memory entry from conversation history",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "compact",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs compact values(historyFile, model, keepLastMessages, models, useModel)"
          ],
          "help": {
            "text": "Compact conversation history by summarizing older messages",
            "variables": [
              {
                "name": "historyFile",
                "text": "The history JSON file to compact",
                "default": "history.json",
                "arg": true
              },
              {
                "name": "model",
                "text": "Model configuration as JSON",
                "default": "{}"
              },
              {
                "name": "keepLastMessages",
                "text": "Number of recent messages to keep verbatim",
                "default": "6"
              },
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              },
              {
                "name": "useModel",
                "text": "Named model from registry to use",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "models",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs models values(models)"
          ],
          "help": {
            "text": "List available models from the registry",
            "variables": [
              {
                "name": "models",
                "text": "Models registry as JSON",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "policy",
          "execute": [
            "profile:ai:agent:policy"
          ],
          "help": {
            "text": "Policy guardrail utilities (check decisions, resolve escalations)"
          }
        }
      ]
    },
    {
      "name": "ai:agent:policy",
      "commands": [
        {
          "name": "check",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs policy-check values(policy, tool, action, usage, calls, runId, costs)"
          ],
          "help": {
            "text": "Check a policy decision for a tool/action against a spend snapshot",
            "variables": [
              {
                "name": "policy",
                "text": "Inline policy object (budget/allow/deny/escalate) delivered as JSON",
                "default": ""
              },
              {
                "name": "tool",
                "text": "The tool name to check (e.g. executeAux4, writeFile, removeFiles)"
              },
              {
                "name": "action",
                "text": "The action subject: a command for executeAux4, or a file path for file tools",
                "default": "",
                "arg": true
              },
              {
                "name": "usage",
                "text": "Token usage snapshot as JSON (input, output, cached, total)",
                "default": "{}"
              },
              {
                "name": "calls",
                "text": "Consequential tool call count so far",
                "default": "0"
              },
              {
                "name": "runId",
                "text": "Run identifier injected into escalation commands (auto-generated when empty)",
                "default": ""
              },
              {
                "name": "costs",
                "text": "Cost rates as JSON (costIn, costOut, costCache per 1M tokens) for the usd budget",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "resolve",
          "execute": [
            "node ${packageDir}/lib/aux4-ai-agent.cjs policy-resolve values(id, decision)"
          ],
          "help": {
            "text": "Resolve a parked (block-mode) policy escalation",
            "variables": [
              {
                "name": "id",
                "text": "The escalation id to resolve",
                "arg": true
              },
              {
                "name": "decision",
                "text": "The decision",
                "options": [
                  "allow_once",
                  "widen",
                  "stop"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
